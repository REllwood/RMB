{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RMB",
  "version": "0.1.0",
  "identifier": "com.rhysellwood.rmb",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RMB",
        "width": 1100,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "category": "Business",
    "shortDescription": "Open-source business manager for small & home businesses",
    "longDescription": "Free, offline desktop app to manage customers, catalog, stock, invoices, and payments — your data on your own machine.",
    "macOS": { "minimumSystemVersion": "10.15" },
    "windows": { "nsis": { "installMode": "currentUser" } },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
